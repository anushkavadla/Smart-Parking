# SMART PARKING — backend environment template.
# Copy to a local untracked file and fill in real values.
# NEVER commit real secrets. This file contains placeholders only.
#
# Windows PowerShell (current session):
#   $env:SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/smart_parking"
#   $env:SPRING_DATASOURCE_USERNAME="root"
#   $env:SPRING_DATASOURCE_PASSWORD="<your-local-mysql-password>"
#   $env:JWT_SECRET="<at-least-32-bytes-random-secret>"
# Spring Boot maps these env vars via application.properties placeholders.
# Alternatively configure them in your IDE run configuration.

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=
